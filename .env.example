# KOHA-CIL Enterprise Intelligence Platform — Environment Config

# ---- Service Ports ----
FRONTEND_PORT=5173
GATEWAY_PORT=3000
BACKEND_PORT=8000

# ---- Service URLs (used by gateway and health-check) ----
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# ---- Ollama (local LLM) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Security ----
# JWT_SECRET will be changed in production!
JWT_SECRET=koha-cil-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=8h

# Internal shared secret between gateway and backend.
# INTERNAL_SECRET will be changed in production!
INTERNAL_SECRET=koha-cil-internal-shared-secret

# ---- Database ----
DATABASE_PATH=../data/koha_cil.db

# ---- Ingestion ----
UPLOAD_DIR=../data/uploads
QUARANTINE_DIR=../data/quarantine
CACHE_DIR=../data/cache

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=../data/chroma

# ---- Logging ----
LOG_LEVEL=INFO
